{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // Non-secret defaults and structure ONLY (spec 13.5). Every secret-bearing key is present
  // with an empty value so the shape is documented and the absence is visible — values come
  // from `dotnet user-secrets` in development and environment variables (double underscore:
  // Whetstone__Ai__ApiKey) in production. ValidateOnStart makes a missing one a boot failure.
  "Whetstone": {
    "Ai": {
      "Provider": "",
      "Model": "",
      "Endpoint": "",
      "ApiKey": ""
    },
    "Corpus": {
      "Host": "github.com",
      "RepoAccessToken": ""
    },
    "Lens": {
      "Registry": "",
      "RegistryApiKey": "",
      "Pins": []
    },
    "Database": {
      "ConnectionString": ""
    }
  }
}
