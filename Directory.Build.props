<Project>

  <!-- Settings that must hold for every project in the solution (spec 13.3).
       Anything enforceable by the build is enforced here, from the first commit. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- A warning you can ignore is a warning you will ignore. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>

    <!-- Identical inputs produce identical binaries. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Supply-chain control: CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Vulnerability audit at restore time. Combined with TreatWarningsAsErrors above, NU1902/NU1903
         become errors, so a vulnerable package fails the restore before anything is compiled.
         Set explicitly rather than inherited: the SDK's default audit mode has changed between
         versions, and "transitive is where the vulnerabilities actually are" (spec 13.6) is only
         true of the build if `all` is the mode in effect. Level `low` because spec 13.6 says fail
         on any hit, not on a severity you talked yourself into. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
